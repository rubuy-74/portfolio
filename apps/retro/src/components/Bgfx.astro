---
import bgDims from "../data/bg-dims.json";

interface Gif {
	src: string;
	style: string;
}

const images = import.meta.glob<{ default: string }>("../assets/gfx/bg_*.gif", {
	query: "?url",
	import: "default",
	eager: true,
});

const dims = bgDims as Record<string, [number, number]>;

function mulberry32(a: number) {
	return function () {
		a |= 0;
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

function hashSeed(s: string): number {
	let h = 2166136261;
	for (let i = 0; i < s.length; i++) {
		h ^= s.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	return h >>> 0;
}

const rng = mulberry32(hashSeed(Astro.url.pathname));
const shadows = ["#cc33ff", "#aaff00", "#ff7a00", "#ff3399", "#00e5ff"];

const entries = Object.entries(dims).filter(([file]) => images[`../assets/gfx/${file}`]);
for (let i = entries.length - 1; i > 0; i--) {
	const j = Math.floor(rng() * (i + 1));
	[entries[i], entries[j]] = [entries[j], entries[i]];
}

const gifs: Gif[] = entries.slice(0, 60).map(([file, [w, h]]) => {
	const dispW = Math.round(46 + rng() * 74);
	const scale = w > 0 ? h / w : 1;
	const dispH = Math.round(dispW * scale);
	const top = (3 + rng() * 90).toFixed(2);
	const left = (rng() * 97).toFixed(2);
	const rotate = Math.round(-30 + rng() * 60);
	const opacity = (0.4 + rng() * 0.55).toFixed(2);
	const shadow =
		rng() < 0.3
			? `filter:drop-shadow(0 0 ${Math.round(2 + rng() * 7)}px ${shadows[Math.floor(rng() * shadows.length)]});`
			: "";
	const style = `top:${top}%;left:${left}%;width:${dispW}px;height:${dispH}px;transform:rotate(${rotate}deg);animation:none;opacity:${opacity};${shadow}`;
	return { src: images[`../assets/gfx/${file}`], style };
});
---

<div class="bgfx" aria-hidden="true">
	{gifs.map((gif) => <img src={gif.src} style={gif.style} alt="" loading="lazy" />)}
</div>
